<?xml version="1.0" encoding="utf-8" ?>
<!-- Diagnostic tracing for the test rig only.

     WCF closes a net.tcp connection without explanation when the transport
     security upgrade is rejected, so this turns the silent reset into a
     logged exception. Not part of the library; it exists to debug [MS-NNS].
-->
<configuration>
  <system.diagnostics>
    <sources>
      <source name="System.ServiceModel"
              switchValue="Verbose,ActivityTracing"
              propagateActivity="true">
        <listeners>
          <add name="traceFile" />
        </listeners>
      </source>
      <source name="System.ServiceModel.MessageLogging" switchValue="Verbose">
        <listeners>
          <add name="traceFile" />
        </listeners>
      </source>
    </sources>
    <sharedListeners>
      <add name="traceFile"
           type="System.Diagnostics.XmlWriterTraceListener"
           initializeData="wcf-trace.svclog" />
    </sharedListeners>
    <trace autoflush="true" />
  </system.diagnostics>
</configuration>
